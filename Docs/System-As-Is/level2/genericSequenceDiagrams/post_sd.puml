@startuml

autonumber

title Post Generic Resource

actor "User" as USER
participant "BackEnd" as System
participant "H2 DataBase" as H2DB

activate USER

    USER -> System: /POST /api/generic
    activate System

        System -> H2DB: INSERT INTO generic VALUES (...)
        activate H2DB

            H2DB --> System: Insert OK
        deactivate H2DB

        System --> USER: returns created resource
    deactivate System

deactivate USER

@enduml
