@startuml

autonumber

title Delete Generic Resource

actor "User" as USER
participant "BackEnd" as System
database "H2 DataBase" as H2DB

activate USER

    USER -> System: /DELETE /api/generic/{id}
    activate System

        System -> H2DB: DELETE FROM generic WHERE id = {id}
        activate H2DB

            H2DB --> System: Deletion OK
        deactivate H2DB

        System --> USER: informs operation success
    deactivate System

deactivate USER

@enduml
