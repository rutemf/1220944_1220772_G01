@startuml

autonumber

title Update Generic Resource By ID (PATCH)

participant "GenericController" as Controller
participant "GenericService" as Service
participant "GenericMapper" as Mapper
participant "GenericRepository" as Repo
participant "GenericDataSchema" as DataSchema
database "SQL DataBase" as MYSQL
database "Mongo DataBase" as MONGO
database "Redis Cache" as REDIS

-> Controller: PATCH /api/generic/{id}
activate Controller

    Controller -> Service: update by id
    activate Service

        Service -> Repo: find by id
        activate Repo

            note right of Repo: GetByID Process

            Repo --> Service: returns entity
        deactivate Repo

        Service -> Mapper: apply patch (DTO to entity)
        activate Mapper

            Mapper --> Service: returns updated entity
        deactivate Mapper

        Service -> Repo: save updated entity
        activate Repo

            Repo -> DataSchema: maps to DataSchema
            activate DataSchema

                DataSchema --> Repo: return dataSchema object
            deactivate DataSchema

            alt Persistence = MySQL

            Repo -> MYSQL: UPDATE generic SET ... WHERE id = {id}
            activate MYSQL

                MYSQL --> Repo: updated data
            deactivate MYSQL

            else Persistence = MongoDB

            Repo -> MONGO: findOneAndUpdate({ id: id }, { $set: ... })
            activate MONGO

                MONGO --> Repo: updated data
            deactivate MONGO

            end

            Repo -> REDIS: update cache entry for id
            activate REDIS

                REDIS --> Repo: cache updated result
            deactivate REDIS

            Repo -> DataSchema: maps to Domain
            activate DataSchema

                DataSchema --> Repo: return domain object
            deactivate DataSchema

            Repo --> Service: returns updated entity
        deactivate Repo

        Service -> Mapper: map to DTO
        activate Mapper

            Mapper --> Service: returns DTO
        deactivate Mapper

        Service --> Controller: returns DTO
    deactivate Service

<-- Controller: returns updated data (DTO)
deactivate Controller

@enduml